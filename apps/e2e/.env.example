# @abyss/e2e environment. `SMOKE_E2E=1 pnpm smoke` sets all of these for you;
# set them yourself only to run against another stack.

# Origin of cms-admin (Chromium resolves *.localhost to loopback itself).
E2E_ADMIN_URL=http://admin.domain.localhost:8080
# cms-api base URL exactly as the admin bundle calls it (VITE_API_BASE_URL).
E2E_API_BASE_URL=http://domain.localhost:8080/api/v1
# An existing owner account (created through POST /setup/owner).
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
# A separate active account for the 2FA spec, with 2FA off at the start.
# scripts/smoke.sh seeds e2e-2fa@<SMOKE_DOMAIN>. The spec turns 2FA on and off
# and changes the password, so use a throwaway account.
E2E_2FA_EMAIL=
E2E_2FA_PASSWORD=
# Two active read-only (guest role) accounts for the web session spec:
# one plain, one with email 2FA on. scripts/smoke.sh seeds e2e-reader@ and
# e2e-reader-2fa@<SMOKE_DOMAIN>.
E2E_READER_EMAIL=
E2E_READER_PASSWORD=
E2E_READER_2FA_EMAIL=
E2E_READER_2FA_PASSWORD=
# Mailpit web/API origin of the smoke stack; OTP codes are read from it.
E2E_MAILPIT_URL=http://mail.domain.localhost:8080
