# @abyss/e2e environment. `SMOKE_E2E=1 pnpm smoke` sets all of these for you;
# set them yourself only to run against another stack.

# Origin of cms-admin (Chromium resolves *.localhost to loopback itself).
E2E_ADMIN_URL=http://admin.domain.localhost:8080
# cms-api base URL exactly as the admin bundle calls it (VITE_API_BASE_URL).
E2E_API_BASE_URL=http://domain.localhost:8080/api/v1
# An existing owner account (created by owner:bootstrap).
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
# Mailpit web/API origin of the smoke stack; OTP codes are read from it (T12).
E2E_MAILPIT_URL=http://mail.domain.localhost:8080
