# @abyss/cms-api environment. Copy to .env.local (loaded by `start:dev` only) or .env, and fill in real values.
# Everything else (start, db:migrate, CLIs, production) reads the shell env, so export these first.
# Validated at boot by src/config/Env.schema.ts; the app refuses to start on any error.

# development | test | production. Production enables the guards marked [prod] below.
NODE_ENV=development

# HTTP port inside the container (SPEC §6: 3000).
PORT=3000

# Core Postgres 17 connection, as separate values (no URL, so no password
# encoding). DB_HOST, DB_NAME, DB_USERNAME and DB_PASSWORD are required.
DB_HOST=localhost
# Optional, default 5432.
DB_PORT=5432
DB_NAME=abyss
# Production uses the DML-only role `abyss_api` here (in the cms-api Secret) and
# the migration role `abyss_migrator` for `deploy:migrate` (in its own Secret);
# on Supabase the name carries `.<project-ref>`. See docs/adr/0012-database-role-separation.md.
DB_USERNAME=abyss
DB_PASSWORD=change-me
# Optional TLS for the database connection: disable (default; local stacks and
# the in-cluster Postgres) | require (encrypted, server not checked) |
# verify-full (encrypted, certificate chain and host name checked). Production
# on Supabase sets verify-full.
DB_SSL_MODE=disable
# Absolute path to the database CA certificate (PEM). Required when
# DB_SSL_MODE=verify-full, ignored otherwise. The CA is public, not a secret.
DB_SSL_ROOT_CERT_PATH=

# Number of reverse-proxy hops to trust for the client IP (D7). Never "true".
TRUST_PROXY_HOPS=1

# Optional header carrying the real client IP, e.g. cf-connecting-ip behind
# Cloudflare (D7). No default. Unset: the client IP is the X-Forwarded-For entry
# TRUST_PROXY_HOPS hops back (Express trust proxy). Set: that header is used
# when it holds one valid IP, else the same fallback. Only set it when the
# origin is reachable through that proxy alone, or clients can forge it.
# Used for rate limits and stored with refresh tokens.
CLIENT_IP_HEADER=

# Origin of cms-admin, the only origin allowed to call the API cross-origin
# (CORS with credentials, SPEC §6 / D14). Scheme + host [+ port], no path or
# trailing slash. Empty = CORS off. [prod] required.
ADMIN_ORIGIN=http://admin.domain.localhost:5173

# Origin of the public web app (SPEC §6: https://domain.com). Not a CORS origin:
# together with ADMIN_ORIGIN it forms the Origin allowlist of the refresh-cookie
# endpoints /auth/refresh and /auth/logout (D14). Same format as ADMIN_ORIGIN.
# [prod] required.
WEB_ORIGIN=http://domain.localhost:5174

# console | smtp. [prod] console is rejected. console writes every email,
# OTP codes included, to the log (development only).
MAIL_PROVIDER=console

# SMTP (MAIL_PROVIDER=smtp; ignored with console). Any submission server works,
# e.g. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=<gmail address>, SMTP_PASSWORD=<16-char Google App Password>.
# Required with smtp: SMTP_HOST and MAIL_FROM.
SMTP_HOST=
# Default 587.
SMTP_PORT=
# true = TLS from the first byte (port 465). false (default) = plain connect,
# upgraded with STARTTLS when the server offers it (port 587). true or false only.
SMTP_SECURE=
# Set both or neither (no auth, e.g. a local Mailpit). The password is
# redacted in logs; it is not length-checked like the secrets below.
SMTP_USER=
SMTP_PASSWORD=
# From header of OTP emails, e.g. Abyss CMS <no-reply@domain.com>.
MAIL_FROM=

# fake | cloudinary. fake keeps uploads in memory (development and tests only,
# lost on restart); [prod] fake is rejected, set cloudinary. Default: fake.
MEDIA_PROVIDER=fake
# Required with MEDIA_PROVIDER=cloudinary (from the Cloudinary console). The API
# key secret is redacted in logs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder every uploaded object is stored under, e.g. abyss/media.
CLOUDINARY_FOLDER=

# Reviewer features switch (ADR 0014). Default false: every reviewer route answers
# 404 REVIEWER_FEATURE_OFF, reviewer tokens are refused and the cleanup job does
# not start. true = on; the owner toggle in cms-admin still applies.
# true or false only (lower case).
REVIEWER_FEATURE_ENABLED=false

# Cloudflare Turnstile secret key (T31, reviewer sessions), from the Cloudflare
# dashboard; redacted in logs. Optional: unset, POST /reviewer/sessions answers
# 503 REVIEWER_UNAVAILABLE (no bypass). Cloudflare documents always-pass/always-fail
# test secret keys for development. The widget's site key is a frontend value.
TURNSTILE_SECRET_KEY=
# Optional (T31): hostname of the page that hosts the Turnstile widget, e.g.
# domain.com. Set: a passing verification must report exactly this hostname.
# Leave unset with Cloudflare's test keys (they report a placeholder hostname).
TURNSTILE_EXPECTED_HOSTNAME=

# Secrets. [prod] each is required and must be at least 32 bytes.
# OTP_PEPPER keys the HMAC of stored one-time codes (D8); without it, password
# reset/invite codes can't be issued or checked.
# TOTP_ENC_KEY encrypts stored authenticator secrets (AES-256-GCM, key derived
# with HKDF-SHA256, D8); without it, TOTP 2FA can't be set up or checked.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
OTP_PEPPER=
TOTP_ENC_KEY=

# Key id of JWT_ACCESS_SECRET, written to every access token's `kid` header and
# claim (D9). 1-64 chars of A-Z a-z 0-9 . _ -. Change it when rotating the
# secret. Default outside production: dev. [prod] required.
JWT_ACCESS_KID=

# Key id of TOTP_ENC_KEY, stored with every encrypted TOTP secret (D8). Same
# format as JWT_ACCESS_KID. Change it when rotating TOTP_ENC_KEY. Default
# outside production: dev. [prod] required.
TOTP_ENC_KID=
# Rotation (optional): the replaced TOTP_ENC_KEY and its kid, kept so old
# secrets still open; each is re-encrypted with the current key after its next
# valid code. Set both or neither; the kid must differ from TOTP_ENC_KID.
# [prod] the key must be at least 32 bytes.
TOTP_ENC_PREVIOUS_KEY=
TOTP_ENC_PREVIOUS_KID=
# Name shown in authenticator apps (1-64 chars, no colon). Default: Abyss CMS.
TOTP_ISSUER=

# Optional limits per 15 minutes for POST /auth/login, replacing the defaults
# (10 per IP, 5 per email). Positive integer up to 1000000; invalid = the API
# fails to start. In production the API fails to start when either is set, unless
# ALLOW_LOGIN_RATE_LIMIT_OVERRIDE=smoke (exactly) is also set; only the
# smoke/e2e stack does that (docker-compose.smoke.yml). Never set it in prod.
ALLOW_LOGIN_RATE_LIMIT_OVERRIDE=
LOGIN_RATE_LIMIT_IP=
LOGIN_RATE_LIMIT_EMAIL=
# Optional limit per minute per IP for POST /auth/refresh (default 30). Same
# rules as above: positive integer up to 1000000, invalid fails the start, and
# in production it needs ALLOW_LOGIN_RATE_LIMIT_OVERRIDE=smoke (same flag).
REFRESH_RATE_LIMIT_IP=

# One-time owner setup token (ADR 0005). Optional: unset, POST /setup/owner is
# closed (404). Set it only to create the owner through the admin setup page,
# generate it with `openssl rand -base64 32`, and REMOVE it (then restart) once
# the owner exists. Sent only in the request body; never a build arg. [prod]
# at least 32 bytes.
OWNER_SETUP_TOKEN=

# Backup bucket (ADR 0013). Optional: set the endpoint, bucket and both keys
# together, or leave all four empty (the Backups feature is then off). The key
# pair is a READ-ONLY token (list + get) for the backup bucket, separate from
# the backup job's write credential. Endpoint: the S3 API origin (https in
# production), e.g. https://<account-id>.r2.cloudflarestorage.com for R2.
# The access key id and secret are redacted in logs.
BACKUP_STORAGE_ENDPOINT=
# Empty = auto (the R2 value).
BACKUP_STORAGE_REGION=
BACKUP_STORAGE_BUCKET=
# Key prefix of the dumps; must end with /. Empty = postgres/
BACKUP_STORAGE_PREFIX=
BACKUP_STORAGE_ACCESS_KEY_ID=
BACKUP_STORAGE_SECRET_ACCESS_KEY=

# --- CLI only (owner:bootstrap, D1). Not read by the API. ---
# Email of the single owner account created by `owner:bootstrap`. The password
# is typed at a hidden prompt or piped with --password-stdin, never set here.
OWNER_EMAIL=
# Optional display name of the owner (default: the email's local part).
OWNER_DISPLAY_NAME=
