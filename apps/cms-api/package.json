{
  "name": "@abyss/cms-api",
  "version": "0.1.0",
  "private": true,
  "description": "Abyss headless CMS REST API (NestJS on Express)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "pnpm run start:dev",
    "start:dev": "nest start --watch --exec \"node --env-file-if-exists=.env.local\"",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --selectProjects unit",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --selectProjects integration",
    "lint": "oxlint && eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "content:generate": "tsc -p tsconfig.build.json && node dist/modules/content-engine/cli/generate.js",
    "graphql:print-schema": "tsc -p tsconfig.build.json && node dist/modules/graphql/cli/print-schema.js",
    "contract:print": "tsc -p tsconfig.build.json && node dist/contract/print-public-constants.js",
    "content:migrate": "node dist/modules/content-engine/cli/migrate.js",
    "deploy:migrate": "npm run --silent db:migrate && npm run --silent content:migrate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && node dist/modules/identity/cli/seed.js",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node dist/modules/identity/cli/seed.js",
    "owner:bootstrap": "node dist/modules/identity/cli/owner-bootstrap.command.js",
    "owner:reset-2fa": "node dist/modules/identity/cli/owner-reset-2fa.js",
    "seed:account": "node dist/modules/identity/cli/seed-account.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "busboy": "1.6.0",
    "cloudinary": "2.11.0",
    "cookie-parser": "1.4.7",
    "file-type": "22.2.0",
    "graphql": "17.0.2",
    "jsonwebtoken": "9.0.3",
    "kysely": "0.28.18",
    "nodemailer": "10.1.7",
    "otplib": "13.5.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "^2.18.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@abyss/base-config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@testcontainers/postgresql": "12.2.1",
    "@types/busboy": "1.5.5",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  }
}
