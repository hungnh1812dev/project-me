# @abyss/web environment. Copy to .env.local for local dev.
# VITE_* keys are baked into the bundle at build time: never put secrets here.

# Base URL of cms-api, without a trailing slash. The public site and the API
# share one origin (SPEC §6), so this is a relative path in every environment.
VITE_API_BASE_URL=/api/v1

# Dev server only (not bundled).
# Port for `pnpm --filter @abyss/web dev` (default 5174).
DEV_SERVER_PORT=5174
# Where the dev server forwards /api, e.g. a local cms-api. Empty = no proxy.
DEV_API_PROXY_TARGET=http://localhost:3000
