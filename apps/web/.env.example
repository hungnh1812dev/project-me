# @abyss/web environment. Copy to .env.local for local dev.
# NEXT_PUBLIC_* keys are baked into the browser bundle at build time: never
# put secrets there. Every other key is read by the Node server at runtime.

# --- Browser (build time) ---
# Base URL of cms-api for browser calls, without a trailing slash. The public
# site and the API share one origin (SPEC §6), so this is a relative path in
# every environment. A missing value fails the build.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Where the "Open CMS" link in the header points: the admin console, as an
# http(s) URL or a path. Optional; empty hides the link. Example:
# https://admin.example.com
NEXT_PUBLIC_ADMIN_URL=
# Cloudflare Turnstile site key for the "Reviewer access" dialog (public by
# design; the secret key lives only in cms-api as TURNSTILE_SECRET_KEY).
# Optional; empty hides the "Reviewer access" button.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server (runtime; an invalid value fails start) ---
# cms-api base URL as the Next server reaches it (container network, never
# sent to the browser). Used by server-side data fetching.
API_INTERNAL_URL=http://localhost:3000/api/v1
# Data cache lifetime in seconds for server-side fetches. 0 disables caching.
# Default 60. The smoke stack uses 0.
WEB_REVALIDATE_SECONDS=60
# Whether /status (the API health card) is served. Only `true` turns it on;
# unset or `false` answers 404. Read per request, so no rebuild is needed.
WEB_STATUS_PAGE_ENABLED=false
# Exact origin of this site, no path (e.g. https://example.com). The BFF accepts
# state-changing requests only from this Origin. Required.
WEB_ORIGIN=http://localhost:5174
# Key material for the sealed session cookies. Required; in production at
# least 32 bytes (e.g. `openssl rand -base64 48`), else start fails.
WEB_SESSION_SECRET=
# Cloudflare Turnstile secret key; the BFF verifies every human check with it.
# Required. Never put it in a NEXT_PUBLIC_* key.
TURNSTILE_SECRET_KEY=
# Bare lower-case hostname a Turnstile answer must carry (e.g. example.com).
# Required when NODE_ENV=production with a real secret; optional otherwise.
TURNSTILE_EXPECTED_HOSTNAME=
# Allows Cloudflare's always-pass test secret in a production build. Only the
# value `smoke` is accepted. Smoke stack only, never in deploy config.
ALLOW_TURNSTILE_TEST_SECRET=
# Proxies in front of the server: the visitor IP is the Nth address from the
# right of X-Forwarded-For. Integer >= 0, default 1.
TRUST_PROXY_HOPS=1
# Header a trusted CDN sets to the visitor IP (e.g. CF-Connecting-IP). Optional;
# when set and valid it wins over X-Forwarded-For.
CLIENT_IP_HEADER=
# Port the production server (Docker image, `pnpm start`) listens on. Default 8080.
WEB_PORT=8080

# --- Dev server only (read from the shell environment, not .env.local) ---
# Port for `pnpm --filter @abyss/web dev` (default 5174).
# DEV_SERVER_PORT=5174
# --- Dev server only (.env.local) ---
# Where the dev server forwards /api, e.g. a local cms-api. Empty = no proxy.
DEV_API_PROXY_TARGET=http://localhost:3000
# `pnpm dev:stack` (scripts/dev-stack.sh) sets DEV_SERVER_PORT, DEV_API_PROXY_TARGET,
# API_INTERNAL_URL and the NEXT_PUBLIC_* keys in the shell for its run; see
# apps/e2e/.env.example for its .localEnv.agent keys.
