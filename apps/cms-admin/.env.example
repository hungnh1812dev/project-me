# @abyss/cms-admin environment. Copy to .env.local for local dev.
# VITE_* keys are baked into the bundle at build time: never put secrets here.

# Absolute URL of cms-api, without a trailing slash. The admin runs on its own
# origin (admin.<domain>, SPEC §6 / D14), so it calls the API cross-origin and
# cms-api must list this app's origin in its ADMIN_ORIGIN.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Dev server only (not bundled).
# Port for `pnpm --filter @abyss/cms-admin dev` (default 5173). Open the app at
# http://admin.domain.localhost:<port> so the origin matches cms-api ADMIN_ORIGIN.
DEV_SERVER_PORT=5173
# `pnpm dev:stack` (scripts/dev-stack.sh) sets VITE_API_BASE_URL and DEV_SERVER_PORT
# in the shell for its run; see apps/e2e/.env.example for its .localEnv.agent keys.
