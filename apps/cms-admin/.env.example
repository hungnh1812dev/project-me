# Backend origin used by production builds, without /api/v1 and without a trailing slash.
# Leave empty in dev: the app then calls the relative /api/v1 and the Vite dev server proxies it.
VITE_API_URL=

# Dev server only: where Vite proxies /api and /health. Defaults to http://localhost:8080.
VITE_API_PROXY_TARGET=http://localhost:8080

# Not VITE_ vars: nginx reads these at container start to build the Content-Security-Policy
# (see docs/testing-and-config.md). Set them on the container, not in this file.
# CSP_API_ORIGIN: the API origin when it is not the admin's own, e.g. https://cms-api.example.com
# CSP_IMG_ORIGINS: space-separated image origins, e.g. the media host that serves thumbnails
# CSP_API_ORIGIN=
# CSP_IMG_ORIGINS=
