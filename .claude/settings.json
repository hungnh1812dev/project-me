{
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(rm .claude/state/findings/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}