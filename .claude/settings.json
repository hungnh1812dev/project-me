{
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(rm .agent-state/features/*/findings/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|SendMessage",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/bin/session-gate" }]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/bin/read-guard" }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/bin/session-gate" }]
      }
    ]
  }
}
