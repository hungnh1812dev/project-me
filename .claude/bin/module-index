#!/usr/bin/env python3
"""Module docs and their index docs/modules/MODULES.md.

Usage (from the repo root):
  .claude/bin/module-index            regenerate the file table of every module doc and docs/modules/MODULES.md
  .claude/bin/module-index --check    fail when a doc or the index is stale, a module touched by the
                                      working tree has no doc, or a touched file's row is still TODO
  .claude/bin/module-index --new <module folder>   create its doc from the template

Module roots: docs/modules/module-roots.txt. A module doc is any docs/modules/**/*.md whose front
matter has `module: <folder>`; other docs there are listed as topic docs. Only the block between the
module-files markers is generated; its Description cells and everything outside it are hand-written.

Spec docs: each docs/flows/<flow>/ and docs/apps/<app>/ holds SPEC.md, FLOW.md and RULES.md; a flow's
SPEC.md has front matter `flow`, `summary`, `replaces` and its FLOW.md `modules` (comma-separated module
folders); an app's SPEC.md has `app`, `summary`, `replaces`. Each docs/global/**/*.md has `summary` and
`replaces`. `replaces` lists the old single-file SPEC ids the doc took over. The Docs table of the root
SPEC.md, the module table of each flow FLOW.md, the Flows and Doc status columns of docs/modules/MODULES.md and the
Flows line of each module doc are generated from them. --check also fails when a flow or app misses a file
or front matter, a flow names a folder that is not a module root, two docs claim the same old id, or a
`## ` section of a global or app RULES.md / FLOW.md has no `Applies to` line or names an unknown flow.
"""
import glob, os, re, subprocess, sys

ROOTS_FILE = "docs/modules/module-roots.txt"
DOCS_DIR = "docs/modules"
INDEX_FILE = "docs/modules/MODULES.md"
FLOWS_DIR = "docs/flows"
FLOW_FILES = ("SPEC.md", "FLOW.md", "RULES.md")
APPS_DIR = "docs/apps"
GLOBAL_DIR = "docs/global"
ROOT_SPEC = "SPEC.md"
PATCH_PREFIX = "patch-"
START = ("<!-- module-files:start (generated by .claude/bin/module-index; edit only the Description column) -->\n"
         "<!-- prettier-ignore-start -->")
END = "<!-- prettier-ignore-end -->\n<!-- module-files:end -->"
SPEC_DOCS = ("<!-- spec-docs:start (generated by .claude/bin/module-index; do not edit) -->",
             "<!-- spec-docs:end -->")
DOC_FLOWS = ("<!-- module-flows:start (generated by .claude/bin/module-index; do not edit) -->",
             "<!-- module-flows:end -->")
FLOW_MODULES = ("<!-- flow-modules:start (generated by .claude/bin/module-index from `modules:`; edit only the Role column) -->\n"
                "<!-- prettier-ignore-start -->",
                "<!-- prettier-ignore-end -->\n<!-- flow-modules:end -->")
TODO = "TODO"
TEST_FILE = re.compile(r"\.(spec|test)\.[cm]?[jt]sx?$|/__snapshots__/|\.snap$")
SKIPPED_DIRS = {"node_modules", "dist", "build", ".next", "generated", "graphify-out", "coverage"}
EXPORT = re.compile(r"^export\s+(?:default\s+)?(?:declare\s+)?(?:abstract\s+)?(?:async\s+)?"
                    r"(?:function\*?|class|const|let|interface|type|enum)\s+([A-Za-z_$][\w$]*)", re.M)
EXPORT_LIST = re.compile(r"^export\s+(?:type\s+)?\{([^}]*)\}", re.M)
MAX_EXPORTS_SHOWN = 4

TEMPLATE = """---
module: {module}
app: {app}
summary: {todo} one line: what this module does for its users
---
# {title} ({app})

## Purpose
{todo} 2-4 lines: the main function of the module and who uses it.

## Techniques
{todo} patterns and rules it relies on (layers, guards, caching, transactions, ...).

## Technologies
{todo} libraries and services it uses directly.

## Entry points
{todo} routes, pages, CLI commands, jobs, public exports.

## Where to change what
{todo} "to add a new X, change Y"; constraints a change must keep.

## Files
{block}
"""


def sh(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout


def read(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


def module_roots():
    roots = {}
    for line in read(ROOTS_FILE).splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        app, pattern = line.split(None, 1)
        for folder in sorted(glob.glob(pattern)):
            if os.path.isdir(folder) and os.path.basename(folder) not in SKIPPED_DIRS:
                roots[folder.rstrip("/")] = app
    return roots


def front_matter(text):
    match = re.match(r"---\n(.*?)\n---\n", text, re.S)
    if not match:
        return {}
    return dict(re.findall(r"^(\w+):[ \t]*(.*)$", match.group(1), re.M))


def module_files(folder):
    sources, test_count = [], 0
    for dirpath, dirnames, filenames in os.walk(folder):
        dirnames[:] = sorted(d for d in dirnames if d not in SKIPPED_DIRS)
        for name in sorted(filenames):
            path = os.path.join(dirpath, name)
            if TEST_FILE.search(path):
                test_count += 1
            else:
                sources.append(path)
    return sources, test_count


def exports_of(path):
    try:
        text = read(path)
    except (UnicodeDecodeError, OSError):
        return []
    names = EXPORT.findall(text)
    for group in EXPORT_LIST.findall(text):
        names += [n.split(" as ")[-1].strip().removeprefix("type ") for n in group.split(",") if n.strip()]
    return list(dict.fromkeys(names))


def default_description(path):
    names = exports_of(path)
    shown = ", ".join(f"`{n}`" for n in names[:MAX_EXPORTS_SHOWN])
    more = f" +{len(names) - MAX_EXPORTS_SHOWN}" if len(names) > MAX_EXPORTS_SHOWN else ""
    return f"{TODO} (exports {shown}{more})" if names else TODO


def file_count(n):
    return f"{n} file" if n == 1 else f"{n} files"


def folder_tree(folder, sources):
    counts = {}
    for path in sources:
        rel_dir = os.path.relpath(os.path.dirname(path), folder)
        counts[rel_dir] = counts.get(rel_dir, 0) + 1
    lines = [f"{os.path.basename(folder)}/ ({file_count(counts.get('.', 0))})"]
    for rel_dir in sorted(d for d in counts if d != "."):
        depth = rel_dir.count(os.sep) + 1
        lines.append(f"{'  ' * depth}{os.path.basename(rel_dir)}/ ({file_count(counts[rel_dir])})")
    return lines


def existing_descriptions(block_text):
    rows = re.findall(r"^\| `([^`]+)` \| (.*) \|$", block_text, re.M)
    return {path: description for path, description in rows if not description.startswith(TODO)}


def render_block(folder, old_block=""):
    sources, test_count = module_files(folder)
    kept = existing_descriptions(old_block)
    lines = [START, "", "```", *folder_tree(folder, sources), "```", "",
             f"Tests: {file_count(test_count)} (not listed).", "",
             "| File | Description |", "|---|---|"]
    for path in sources:
        rel = os.path.relpath(path, folder)
        lines.append(f"| `{rel}` | {kept.get(rel) or default_description(path)} |")
    lines += ["", END]
    return "\n".join(lines)


def split_doc(text):
    if START in text and END in text:
        head, rest = text.split(START, 1)
        old_block, tail = rest.split(END, 1)
        return head, old_block, tail
    return text.rstrip("\n") + "\n\n## Files\n", "", "\n"


def module_docs():
    docs, topics = {}, []
    for path in sorted(glob.glob(f"{DOCS_DIR}/**/*.md", recursive=True)):
        if path == INDEX_FILE or is_patch_doc(path):
            continue
        meta = front_matter(read(path))
        if meta.get("module"):
            docs[meta["module"].rstrip("/")] = (path, meta)
        else:
            title = next((l[2:].strip() for l in read(path).splitlines() if l.startswith("# ")), path)
            topics.append((path, title))
    return docs, topics


def flows_of_modules(flows):
    by_module = {}
    for name, meta in flows.items():
        for folder in meta["modules"]:
            by_module.setdefault(folder, []).append(name)
    return by_module


def render_doc_flows(path, names):
    links = ", ".join(f"[`{n}`]({os.path.relpath(f'{FLOWS_DIR}/{n}/FLOW.md', os.path.dirname(path))})"
                      for n in names)
    return f"{DOC_FLOWS[0]}\n\nFlows: {links or 'none yet'}.\n\n{DOC_FLOWS[1]}"


def with_doc_flows(path, head, names):
    block = render_doc_flows(path, names)
    if DOC_FLOWS[0] in head and DOC_FLOWS[1] in head:
        before, rest = head.split(DOC_FLOWS[0], 1)
        return before + block + rest.split(DOC_FLOWS[1], 1)[1]
    title = re.search(r"^# .*\n", head, re.M)
    if not title:
        return head
    return head[:title.end()] + "\n" + block + "\n" + head[title.end():]


def updated_doc_text(path, folder, flow_names=()):
    text = read(path)
    head, old_block, tail = split_doc(text)
    return text, with_doc_flows(path, head, flow_names) + render_block(folder, old_block) + tail


def flow_folders():
    return sorted(d for d in glob.glob(f"{FLOWS_DIR}/*") if os.path.isdir(d))


def load_flows():
    flows = {}
    for folder in flow_folders():
        name = os.path.basename(folder)
        spec, flow = (f"{folder}/{f}" for f in FLOW_FILES[:2])
        spec_meta = front_matter(read(spec)) if os.path.exists(spec) else {}
        flow_meta = front_matter(read(flow)) if os.path.exists(flow) else {}
        modules = [m.strip().rstrip("/") for m in flow_meta.get("modules", "").split(",") if m.strip()]
        flows[name] = {"summary": spec_meta.get("summary", "-"), "modules": modules}
    return flows


def flow_roles(block_text):
    rows = re.findall(r"^\| `([^`]+)` \| (.*?) \| .* \|$", block_text, re.M)
    return {folder: role for folder, role in rows}


def render_flow_modules(flow_path, modules, docs, old_block=""):
    roles = flow_roles(old_block)
    lines = [FLOW_MODULES[0], "", "| Module | Role in this flow | Doc |", "|---|---|---|"]
    for folder in modules:
        path = docs.get(folder, (None,))[0]
        doc = f"[{os.path.basename(path)}]({os.path.relpath(path, os.path.dirname(flow_path))})" if path else "none yet"
        lines.append(f"| `{folder}` | {roles.get(folder) or TODO} | {doc} |")
    return "\n".join(lines + ["", FLOW_MODULES[1]])


def updated_flow_text(flow_path, modules, docs):
    text = read(flow_path)
    start, end = FLOW_MODULES
    if start not in text or end not in text:
        return text, text
    head, rest = text.split(start, 1)
    old_block, tail = rest.split(end, 1)
    return text, head + render_flow_modules(flow_path, modules, docs, old_block) + tail


def flow_problems(flows, roots, docs=None):
    problems = []
    for folder in flow_folders():
        name = os.path.basename(folder)
        for f in FLOW_FILES:
            if not os.path.exists(f"{folder}/{f}"):
                problems.append(f"{folder}: missing {f}")
        flow_path = f"{folder}/FLOW.md"
        if os.path.exists(flow_path):
            text = read(flow_path)
            if FLOW_MODULES[0] not in text:
                problems.append(f"{flow_path}: needs the flow-modules markers (generated module table)")
            elif docs is not None:
                if text != updated_flow_text(flow_path, flows[name]["modules"], docs)[1]:
                    problems.append(f"{flow_path}: module table is stale (run .claude/bin/module-index)")
                elif f"| {TODO} |" in text:
                    problems.append(f"{flow_path}: describe each module's role (a Role cell is still TODO)")
        spec_meta = front_matter(read(f"{folder}/SPEC.md")) if os.path.exists(f"{folder}/SPEC.md") else {}
        if spec_meta.get("flow") != name or not spec_meta.get("summary"):
            problems.append(f"{folder}/SPEC.md: front matter needs `flow: {name}` and `summary:`")
        if not flows[name]["modules"]:
            problems.append(f"{folder}/FLOW.md: front matter needs `modules:` (module folders, comma-separated)")
        for module in flows[name]["modules"]:
            if module not in roots:
                problems.append(f"{folder}/FLOW.md: {module} is not a module root in {ROOTS_FILE}")
    return problems


def module_label(folder, roots):
    inside = re.sub(r"^(apps|packages)/[^/]+/(src/)?", "", folder)
    return f"{roots.get(folder, '?')}/{inside}"


def is_patch_doc(path):
    """A DevOps patch note `patch-<name>-<version>.md` (docs/global/FLOW.md "Versions and change log"), not a doc."""
    return os.path.basename(path).startswith(PATCH_PREFIX)


def global_docs():
    paths = glob.glob(f"{GLOBAL_DIR}/*.md") + glob.glob(f"{GLOBAL_DIR}/*/*.md")
    return sorted(p for p in paths if not is_patch_doc(p))


def app_folders():
    return sorted(d for d in glob.glob(f"{APPS_DIR}/*") if os.path.isdir(d))


def spec_docs():
    """(kind, link target, label, summary, replaces) for every global doc, app and flow."""
    rows = []
    for path in global_docs():
        meta = front_matter(read(path))
        rows.append(("global", path, path.removeprefix(GLOBAL_DIR + "/"), meta.get("summary", "-"), meta.get("replaces", "")))
    for kind, folders in (("app", app_folders()), ("flow", flow_folders())):
        for folder in folders:
            spec = f"{folder}/SPEC.md"
            meta = front_matter(read(spec)) if os.path.exists(spec) else {}
            rows.append((kind, folder, os.path.basename(folder), meta.get("summary", "-"), meta.get("replaces", "")))
    return rows


def replaced_ids(replaces):
    return [r.strip() for r in replaces.split(",") if r.strip()]


def render_spec_docs():
    rows = spec_docs()
    files = lambda target: " · ".join(f"[{f}]({target}/{f})" for f in FLOW_FILES)
    replaced = lambda replaces: ", ".join(replaced_ids(replaces)) or "-"
    lines = ["### Global", "", "| Doc | Holds | Replaces (old SPEC) |", "|---|---|---|"]
    lines += [f"| [`{label}`]({target}) | {summary} | {replaced(rep)} |"
              for kind, target, label, summary, rep in rows if kind == "global"]
    for kind, title, column in (("app", "Apps", "App"), ("flow", "Flows", "Flow")):
        lines += ["", f"### {title}", "", f"| {column} | Files | Holds | Replaces (old SPEC) |", "|---|---|---|---|"]
        lines += [f"| `{label}` | {files(target)} | {summary} | {replaced(rep)} |"
                  for row_kind, target, label, summary, rep in rows if row_kind == kind]
    return "\n".join(lines)


def scope_problems(flows):
    problems = []
    paths = [f"{GLOBAL_DIR}/{f}" for f in ("RULES.md", "FLOW.md")]
    paths += [f"{folder}/{f}" for folder in app_folders() for f in ("RULES.md", "FLOW.md")]
    for path in paths:
        if not os.path.exists(path):
            continue
        for section in re.split(r"^## ", read(path), flags=re.M)[1:]:
            heading = section.splitlines()[0]
            applies = re.search(r"^Applies to\b.*$", section, re.M)
            if not applies:
                problems.append(f"{path}: section \"{heading}\" needs an `Applies to` line (all flows, or the flows it covers)")
                continue
            for name in re.findall(r"`([^`]+)`", applies.group(0)):
                if name not in flows:
                    problems.append(f"{path}: section \"{heading}\" applies to unknown flow `{name}`")
    return problems


def spec_doc_problems(roots, flows):
    problems = scope_problems(flows)
    owners = {}
    for kind, target, label, summary, replaces in spec_docs():
        where = target if kind == "global" else f"{target}/SPEC.md"
        if summary == "-":
            problems.append(f"{where}: front matter needs `summary:`")
        for old_id in replaced_ids(replaces):
            if old_id in owners:
                problems.append(f"old id {old_id} is claimed by both {owners[old_id]} and {where}")
            owners.setdefault(old_id, where)
    apps = set(roots.values())
    for folder in app_folders():
        name = os.path.basename(folder)
        if name not in apps:
            problems.append(f"{folder}: {name} is not an app in {ROOTS_FILE}")
        for f in FLOW_FILES:
            if not os.path.exists(f"{folder}/{f}"):
                problems.append(f"{folder}: missing {f}")
        meta = front_matter(read(f"{folder}/SPEC.md")) if os.path.exists(f"{folder}/SPEC.md") else {}
        if meta.get("app") != name:
            problems.append(f"{folder}/SPEC.md: front matter needs `app: {name}`")
    return problems


def doc_status(folder, docs):
    if folder not in docs:
        return "missing"
    head, block, _tail = split_doc(read(docs[folder][0]))
    if f"{TODO} " in head or re.search(rf"^\| `[^`]+` \| {TODO}", block, re.M):
        return "draft"
    return "complete"


def replace_between(text, markers, body):
    start, end = markers
    if start not in text or end not in text:
        return text
    before, rest = text.split(start, 1)
    return before + start + "\n" + body + "\n" + end + rest.split(end, 1)[1]


def updated_spec_text(roots, docs, flows):
    text = read(ROOT_SPEC)
    return text, replace_between(text, SPEC_DOCS, render_spec_docs())


def render_index(roots, docs, topics, flows):
    by_module = flows_of_modules(flows)
    lines = ["# Modules index", "",
             "Generated by `.claude/bin/module-index`; do not edit. Find where a feature, bug or task lives here,",
             "then read the module doc, then `graphify explain`, then only the lines you need.", "",
             "Doc status: `complete` = the doc has no TODO left; `draft` = the doc exists but a section or a file row",
             "is still TODO; `missing` = no doc yet (`.claude/bin/module-index --new <folder>`). Flows: the business",
             "flows in `docs/flows/` whose `FLOW.md` names the module.", ""]
    for app in dict.fromkeys(roots.values()):
        lines += [f"## {app}", "", "| Module | Folder | Doc | Doc status | Flows | Summary |",
                  "|---|---|---|---|---|---|"]
        for folder, folder_app in roots.items():
            if folder_app != app:
                continue
            path, meta = docs.get(folder, (None, {}))
            doc = f"`{path}`" if path else "-"
            summary = meta.get("summary", "-") if path else "-"
            names = ", ".join(f"[`{n}`]({os.path.relpath(f'{FLOWS_DIR}/{n}/FLOW.md', os.path.dirname(INDEX_FILE))})"
                              for n in by_module.get(folder, [])) or "-"
            lines.append(f"| {os.path.basename(folder)} | `{folder}` | {doc} | {doc_status(folder, docs)} | {names} | {summary} |")
        lines.append("")
    lines += ["## Topic docs", "", "| Doc | Title |", "|---|---|"]
    lines += [f"| `{path}` | {title} |" for path, title in topics]
    return "\n".join(lines) + "\n"


def touched_files():
    changed = sh("git", "diff", "--name-only", "HEAD").split()
    untracked = sh("git", "ls-files", "--others", "--exclude-standard").split()
    return set(changed + untracked)


def owning_module(path, roots):
    owners = [folder for folder in roots if path.startswith(folder + "/")]
    return max(owners, key=len) if owners else None


def check(roots, docs, topics, flows):
    problems = flow_problems(flows, roots, docs) + spec_doc_problems(roots, flows)
    by_module = flows_of_modules(flows)
    for folder, (path, _meta) in docs.items():
        if folder not in roots:
            problems.append(f"{path}: module {folder} is not under any root in {ROOTS_FILE}")
            continue
        text, new_text = updated_doc_text(path, folder, by_module.get(folder, []))
        if text != new_text:
            problems.append(f"{path}: file table or Flows line is stale (run .claude/bin/module-index)")
    if os.path.exists(ROOT_SPEC):
        text, new_text = updated_spec_text(roots, docs, flows)
        if text != new_text:
            problems.append(f"{ROOT_SPEC}: Docs table is stale (run .claude/bin/module-index)")
    if os.path.exists(INDEX_FILE) and read(INDEX_FILE) != render_index(roots, docs, topics, flows):
        problems.append(f"{INDEX_FILE}: stale (run .claude/bin/module-index)")
    elif not os.path.exists(INDEX_FILE):
        problems.append(f"{INDEX_FILE}: missing (run .claude/bin/module-index)")
    for path in sorted(touched_files()):
        folder = owning_module(path, roots)
        if not folder or TEST_FILE.search(path):
            continue
        if folder not in docs:
            problems.append(f"{folder}: touched ({path}) but has no doc (run .claude/bin/module-index --new {folder})")
            continue
        doc_path = docs[folder][0]
        if f"{TODO} " in split_doc(read(doc_path))[0]:
            problems.append(f"{doc_path}: fill the hand-written sections (still TODO)")
        rel = os.path.relpath(path, folder)
        row = existing_descriptions(split_doc(read(doc_path))[1]).get(rel, "")
        if os.path.exists(path) and row.startswith(TODO):
            problems.append(f"{doc_path}: describe `{rel}` (row is still TODO)")
    for message in dict.fromkeys(problems):
        print(message)
    return 1 if problems else 0


def create_doc(folder, roots):
    folder = folder.rstrip("/")
    if folder not in roots:
        sys.exit(f"{folder} is not a module root in {ROOTS_FILE}")
    app = roots[folder]
    path = f"{DOCS_DIR}/{app}/{os.path.basename(folder)}.md"
    if os.path.exists(path):
        # another module of the app has the same folder name (features/status, views/status)
        path = f"{DOCS_DIR}/{app}/{os.path.basename(os.path.dirname(folder))}-{os.path.basename(folder)}.md"
    if os.path.exists(path):
        sys.exit(f"{path} already exists")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    title = os.path.basename(folder).replace("-", " ").capitalize()
    with open(path, "w", encoding="utf-8") as f:
        f.write(TEMPLATE.format(module=folder, app=app, title=title, todo=TODO, block=render_block(folder)))
    print(path)


def regenerate(roots, docs, topics, flows):
    by_module = flows_of_modules(flows)
    for folder, (path, _meta) in docs.items():
        if folder in roots:
            text, new_text = updated_doc_text(path, folder, by_module.get(folder, []))
            if text != new_text:
                with open(path, "w", encoding="utf-8") as f:
                    f.write(new_text)
                print(f"updated {path}")
    with open(INDEX_FILE, "w", encoding="utf-8") as f:
        f.write(render_index(roots, docs, topics, flows))
    if os.path.exists(ROOT_SPEC):
        text, new_text = updated_spec_text(roots, docs, flows)
        if text != new_text:
            with open(ROOT_SPEC, "w", encoding="utf-8") as f:
                f.write(new_text)
            print(f"updated {ROOT_SPEC}")
    for name, meta in flows.items():
        flow_path = f"{FLOWS_DIR}/{name}/FLOW.md"
        if os.path.exists(flow_path):
            text, new_text = updated_flow_text(flow_path, meta["modules"], docs)
            if text != new_text:
                with open(flow_path, "w", encoding="utf-8") as f:
                    f.write(new_text)
                print(f"updated {flow_path}")
    for message in flow_problems(flows, roots, docs) + spec_doc_problems(roots, flows):
        print(message)


def main():
    os.chdir(sh("git", "rev-parse", "--show-toplevel").strip() or ".")
    roots = module_roots()
    args = sys.argv[1:]
    if args[:1] == ["--new"] and len(args) == 2:
        create_doc(args[1], roots)
        roots = module_roots()
        regenerate(roots, *module_docs(), load_flows())
        return 0
    docs, topics = module_docs()
    flows = load_flows()
    if args == ["--check"]:
        return check(roots, docs, topics, flows)
    if args:
        sys.exit(__doc__)
    regenerate(roots, docs, topics, flows)
    return 0


if __name__ == "__main__":
    sys.exit(main())
