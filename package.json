{
  "name": "abyss",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "test": "turbo run test --filter=!@abyss/e2e",
    "e2e": "pnpm --filter @abyss/e2e test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "turbo run build --filter=@abyss/base-config --filter=@abyss/form-commons && prettier --write .",
    "format:check": "turbo run build --filter=@abyss/base-config --filter=@abyss/form-commons && prettier --check .",
    "format:staged": "turbo run build --filter=@abyss/base-config --filter=@abyss/form-commons --output-logs=errors-only && lint-staged",
    "smoke": "bash scripts/smoke.sh",
    "e2e:spec": "bash scripts/e2e-spec.sh",
    "dev:stack": "bash scripts/dev-stack.sh start",
    "demo": "bash scripts/dev-stack.sh demo",
    "dev:stack:stop": "bash scripts/dev-stack.sh stop",
    "dev:stack:seed": "bash scripts/dev-stack.sh seed",
    "start:dev": "pnpm --parallel --filter @abyss/cms-api --filter @abyss/cms-admin --filter @abyss/web dev",
    "start:cms-admin": "pnpm --filter @abyss/cms-admin dev",
    "start:web": "pnpm --filter @abyss/web dev",
    "start:cms-api": "pnpm --filter @abyss/cms-api start",
    "start:cms-api:dev": "pnpm --filter @abyss/cms-api start:dev"
  },
  "devDependencies": {
    "@abyss/base-config": "workspace:*",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern"
  }
}
