{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "env": ["APP_ENV"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!docs/**",
        "!**/*.spec.*",
        "!**/*.test.*",
        "!test/**"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "passThroughEnv": ["APP_ENV"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"],
      "passThroughEnv": ["APP_ENV"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"],
      "passThroughEnv": ["APP_ENV"],
      "outputs": []
    },
    "db:generate": {
      "outputs": ["src/generated/**"]
    }
  }
}
