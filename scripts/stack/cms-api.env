# Static, non-secret cms-api settings of the local smoke stack (docker-compose.smoke.yml,
# `env_file:`) and of the CI e2e stack (scripts/e2e-stack.sh, `--env-file`).
# KEY=value, one per line, no quotes, no interpolation: both docker and compose read it
# literally. Secrets, origins and per-run values are passed by each script, never here.
# Hosts `db` and `mailpit` are network aliases of both stacks.
NODE_ENV=production
PORT=3000
DB_HOST=db
DB_PORT=5432
DB_NAME=abyss
DB_USERNAME=abyss
TRUST_PROXY_HOPS=1
MAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
TOTP_ISSUER=Abyss Smoke
# T27: production rejects MEDIA_PROVIDER=fake. Dummy Cloudinary values: the stack
# boots, real uploads are not exercised here.
MEDIA_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=smoke-dummy
CLOUDINARY_API_KEY=smoke-dummy-key
CLOUDINARY_API_SECRET=smoke-dummy-secret
# T18b: the e2e suite signs in many times from one IP; raise the login limits here
# only (production keeps the defaults, 10 per IP / 5 per email). Production refuses
# the two limits below without this exact opt-in.
ALLOW_LOGIN_RATE_LIMIT_OVERRIDE=smoke
LOGIN_RATE_LIMIT_IP=10000
LOGIN_RATE_LIMIT_EMAIL=10000
# T18c: every e2e sign-in refreshes the session; same opt-in flag.
REFRESH_RATE_LIMIT_IP=10000
# T32: Cloudflare's public always-pass Turnstile test secret. Test stacks only, never
# production config. Verification still calls Cloudflare, so the reviewer e2e needs
# internet.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
