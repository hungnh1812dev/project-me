# Static, non-secret cms-api settings of the local smoke stack (docker-compose.smoke.yml,
# `env_file:`). Local only, not used in CI.
# KEY=value, one per line, no quotes, no interpolation: compose reads it literally.
# The database user and password (API role) are set in the compose file.
# Secrets, origins and per-run values are passed by scripts/smoke.sh, never here.
# Hosts `db` and `mailpit` are network aliases of the stack.
NODE_ENV=production
PORT=3000
DB_HOST=db
DB_PORT=5432
DB_NAME=abyss
TRUST_PROXY_HOPS=1
MAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
TOTP_ISSUER=Abyss Smoke
# production rejects MEDIA_PROVIDER=fake. Dummy Cloudinary values: the stack
# boots, real uploads are not exercised here.
MEDIA_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=smoke-dummy
CLOUDINARY_API_KEY=smoke-dummy-key
CLOUDINARY_API_SECRET=smoke-dummy-secret
# the e2e suite signs in many times from one IP; raise the login limits here
# only (production keeps the defaults, 10 per IP / 5 per email). Production refuses
# the two limits below without this exact opt-in.
ALLOW_LOGIN_RATE_LIMIT_OVERRIDE=smoke
LOGIN_RATE_LIMIT_IP=10000
LOGIN_RATE_LIMIT_EMAIL=10000
# every e2e sign-in refreshes the session; same opt-in flag.
REFRESH_RATE_LIMIT_IP=10000
# reviewer features stay on in test stacks (ADR 0014); production defaults to off.
REVIEWER_FEATURE_ENABLED=true
# Cloudflare's public always-pass Turnstile test secret. Test stacks only, never
# production config. Verification still calls Cloudflare, so the reviewer e2e needs
# internet.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# one-time owner setup token (ADR 0005). A public TEST value, never a secret and
# never for production; 32+ bytes so a production-mode boot accepts it. smoke.sh
# creates the owner through POST /setup/owner with it and reads it from this file.
OWNER_SETUP_TOKEN=smoke-test-setup-token-not-a-secret-0123456789abcdef
