# Build args of the e2e web image, read by scripts/e2e-stack.sh and by the CI e2e
# workflow, so both build the same image. Same values as the web build in
# docker-compose.smoke.yml. KEY=value, no quotes.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# T32: Cloudflare's public always-pass Turnstile test site key. Test builds only;
# production builds use the real key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
