{
  "name": "@abyss/base-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Prettier, ESLint and Oxlint configs for the Abyss monorepo",
  "type": "module",
  "exports": {
    "./prettier": {
      "types": "./dist/Prettier.setup.d.ts",
      "import": "./dist/Prettier.setup.js",
      "default": "./dist/Prettier.setup.js"
    },
    "./eslint": {
      "types": "./dist/Eslint.setup.d.ts",
      "import": "./dist/Eslint.setup.js",
      "default": "./dist/Eslint.setup.js"
    },
    "./oxlint": {
      "types": "./dist/Oxlint.setup.d.ts",
      "import": "./dist/Oxlint.setup.js",
      "default": "./dist/Oxlint.setup.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test",
    "lint": "oxlint && eslint .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.2"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
