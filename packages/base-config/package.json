    "oxlint": "^1.88.0",
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
